# The settings of the campus server package. On the server, copy this file
# to .env.campus beside compose.campus.yaml and fill in each value. Never
# commit the copy. docs/HOSTING.md says how to start the package.

# The password of the package's own database. Make up a long one, of
# letters and digits only: it becomes part of the database's address. It
# is set when the package first starts; changing it here later does not
# change it in the database.
DATABASE_PASSWORD=

# The two keys of the package's own file storage. Make them up: the first
# at least 3 characters, the second at least 8.
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

# Sign-in with Google: the two keys Google gives for the app. The second
# is a real key.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The ending of a campus email address, from the "@" on. Only addresses
# that end with it may sign in.
CAMPUS_EMAIL_ENDING=

# The port of the server the app answers at. Leave it empty for 3000.
APP_PORT=
