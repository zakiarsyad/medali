{
  "name": "medali",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm db:start && pnpm db:migrate && pnpm files:setup && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:start": "docker compose up --detach --wait db",
    "db:stop": "docker compose stop db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate-command.ts",
    "db:seed": "tsx --env-file=src/db/local-commands.env --env-file-if-exists=.env.local src/db/seed-command.ts",
    "db:setup": "pnpm db:start && pnpm db:migrate && pnpm db:seed",
    "db:deploy": "tsx src/db/deploy-command.ts",
    "files:start": "docker compose up --detach --wait files",
    "files:stop": "docker compose stop files",
    "files:prepare": "tsx --env-file=src/db/local-commands.env --env-file-if-exists=.env.local src/files/prepare-command.ts",
    "files:setup": "pnpm files:start && pnpm files:prepare",
    "files:deploy": "tsx src/files/deploy-command.ts"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
