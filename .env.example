# Copy this file to .env.local and fill in each value. Never commit the copy.

# Where the database is. Locally it is the Docker database:
# postgres://medali@localhost:5432/medali
DATABASE_URL=

# Where the database of the checks is. Leave it empty: the checks then use
# postgres://medali@localhost:5432/medali_test
# Fill it in only when more than one copy of the repo is worked on at the
# same time on this computer. Each copy then names its own two databases,
# here and in DATABASE_URL above, such as medali_two and medali_two_test,
# and makes them with: pnpm db:create
# It must never name the same database as DATABASE_URL.
TEST_DATABASE_URL=

# Where the file storage is. Locally it is the Docker file storage:
# http://localhost:9000
FILE_STORAGE_URL=

# The name of the place for files in the file storage. Locally:
# medali
FILE_STORAGE_BUCKET=

# The two keys of the file storage. Locally they are the two values that
# compose.yaml sets for the Docker file storage, which only this computer
# can reach: the first for the access key, the second for the secret key.
# Anywhere else they are real keys: never write them in the repo.
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

# Sign-in with Google. Fill in all three, or leave all three empty: while
# any is empty, "Masuk dengan Google" says it is not set up. The first two
# are what Google gives for the app. The second is a real key: never write
# it in the repo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The ending of a campus email address, from the "@" on. Only addresses
# that end with it may sign in or be given to a staff account.
CAMPUS_EMAIL_ENDING=

# "Kontak konseling kampus": how a student reaches the campus counsellors,
# such as a phone number or a room, shown on Profil saya under the line
# that says where to get help. It may be left empty: nothing more shows.
CAMPUS_COUNSELLING_CONTACT=
